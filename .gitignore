# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
out/
build/
*.tsbuildinfo
# A stray bundle at the workspace root: this repo has no root entry point, so
# an index.js here is always something a build wrote by accident. One was
# committed that way once.
/index.js

# electron-builder buildResources (entitlements, icons) are source, not output —
# carve them out of the blanket build/ ignore above.
!apps/desktop/build/

# Electron packaging / distributables
apps/desktop/release/
apps/desktop/release-stage/
*.app
*.dmg
*.exe
*.AppImage
*.deb
*.snap

# Native module build artifacts
prebuilds/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Test / coverage
coverage/
playwright-report/
test-results/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/

# Environment
.env
.env.local
.env.*.local

# Claude Design exports (redundant with the extracted source under design/)
design/*.zip
design/**/.thumbnail
# Seeded canvas payloads — ~2MB of editor code wrapped around the artboards.
# The .dc.html artboards and canvas.json beside them are the source; the
# seeded page is regenerated from them.
design/**/pwrgit-*.html
