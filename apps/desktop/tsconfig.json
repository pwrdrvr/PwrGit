{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "scripts/**/*.ts",
    "test-support/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
