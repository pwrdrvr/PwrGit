#!/bin/sh
# Contrived `glab` for design screenshots. `auth status` writes to STDERR.
if [ "$1" = "--version" ]; then echo "glab version 1.117.0 (contrived)"; exit 0; fi
if [ "$1" = "auth" ] && [ "$2" = "status" ]; then
  cat >&2 <<'TXT'
gitlab.com
  ✓ Logged in to gitlab.com as ada-l (keyring)
  ✓ Git operations for gitlab.com configured to use ssh protocol.
TXT
  exit 0
fi
if [ "$1" = "config" ] && [ "$2" = "get" ] && [ "$3" = "token" ]; then
  # Only gitlab.com holds a credential; the hand-added instance does not.
  case "$5" in
    gitlab.com) echo "glpat-contrived0000000000" ; exit 0 ;;
    *) echo "" ; exit 0 ;;
  esac
fi
exit 1
