{
  "name": "@pwrgit/desktop",
  "productName": "PwrGit",
  "version": "0.4.0",
  "private": true,
  "description": "Cross-platform desktop git client",
  "author": "PwrDrvr LLC",
  "license": "MIT",
  "copyright": "Copyright © 2026 PwrDrvr LLC",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "generate:app-icon": "swift ./scripts/generate-app-icon.swift ./build/icon.iconset && iconutil -c icns build/icon.iconset -o build/icon.icns",
    "generate:dmg-background": "swift ./scripts/generate-dmg-background.swift ./build/dmg-background.png",
    "generate:tray-icon": "node ./scripts/generate-tray-icon.mjs",
    "generate:branding-assets": "pnpm run generate:app-icon && pnpm run generate:tray-icon && pnpm run generate:dmg-background",
    "tray-icon": "node ./scripts/generate-tray-icon.mjs",
    "postinstall": "electron-rebuild -f",
    "preview": "electron-vite preview",
    "rebuild:electron-native": "electron-rebuild -f",
    "package:dryrun": "node ./scripts/release.mjs --dryrun",
    "package": "node ./scripts/release.mjs --no-publish",
    "package:win": "node ./scripts/release.mjs --win",
    "release": "node ./scripts/release.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest:e2e": "electron-vite build",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@octokit/graphql": "^8.2.1",
    "@pwrdrvr/agent-core": "^0.2.0",
    "@pwrdrvr/codex-discovery": "^0.1.4",
    "@pwrgit/shared": "workspace:*",
    "@shutterstock/p-map-iterable": "^1.1.2",
    "better-sqlite3": "^12.10.0",
    "dugite": "^3.2.3",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.10.4",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.3",
    "vite": "^7.3.5"
  }
}
