{
  "name": "@pwrgit/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server for discovering and inspecting local GitHub and GitLab checkouts",
  "author": "PwrDrvr LLC",
  "license": "MIT",
  "copyright": "Copyright © 2026 PwrDrvr LLC",
  "type": "module",
  "bin": {
    "pwrgit-mcp": "./bin/pwrgit-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./access-policy": "./src/access-policy.ts",
    "./gh-default": "./src/gh-default.ts",
    "./nested-worktrees": "./src/nested-worktrees.ts",
    "./remote": "./src/remote.ts"
  },
  "scripts": {
    "build": "node ../../scripts/resource-run.mjs node ../../node_modules/typescript/lib/tsc.js -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "start": "node ./bin/pwrgit-mcp.js",
    "typecheck": "node ../../scripts/resource-run.mjs node ../../scripts/typecheck.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "dugite": "^3.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
