{
  "name": "@pwrgit/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-owned PwrGit MCP implementation and authenticated stdio relay",
  "author": "PwrDrvr LLC",
  "license": "MIT",
  "copyright": "Copyright © 2026 PwrDrvr LLC",
  "type": "module",
  "bin": {
    "pwrgit-mcp": "./bin/pwrgit-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./access-policy": "./src/access-policy.ts",
    "./agent-access-protocol": "./src/agent-access-protocol.ts",
    "./stdio-relay": "./src/stdio-relay.ts",
    "./nested-worktrees": "./src/nested-worktrees.ts"
  },
  "scripts": {
    "build": "node ../../scripts/resource-run.mjs node ../../node_modules/typescript/lib/tsc.js -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "start": "node ./bin/pwrgit-mcp.js",
    "typecheck": "node ../../scripts/resource-run.mjs node ../../scripts/typecheck.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "^8.22.0",
    "dugite": "^3.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
