{
  "name": "pwrgit-workspace",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "Cross-platform desktop git client (Pwr family)",
  "author": "PwrDrvr LLC",
  "license": "MIT",
  "copyright": "Copyright \u00a9 2026 PwrDrvr LLC",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "scripts": {
    "preinstall": "node ./scripts/check-node-version.mjs",
    "build": "pnpm --filter @pwrgit/mcp-server build && pnpm --filter @pwrgit/desktop build",
    "dev": "pnpm --filter @pwrgit/desktop dev",
    "lint": "pnpm lint:forge-kinds && pnpm lint:colors && pnpm deps:maturity && pnpm licenses:check && pnpm lint:boundaries && pnpm typecheck",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs packages/ apps/desktop/src/",
    "lint:colors": "node ./scripts/lint-renderer-colors.mjs",
    "lint:forge-kinds": "node ./scripts/check-forge-kind-branching.mjs",
    "deps:maturity": "node ./scripts/check-dependency-maturity.mjs",
    "licenses:allowlist": "node ./scripts/check-third-party-license-allowlist.mjs",
    "licenses:check": "node ./scripts/check-package-license-policy.mjs && node ./scripts/check-third-party-license-allowlist.mjs && node ./scripts/generate-third-party-licenses.mjs --check",
    "licenses:generate": "node ./scripts/generate-third-party-licenses.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @pwrgit/desktop test:e2e",
    "test:desktop-e2e": "pnpm --filter @pwrgit/desktop test:e2e",
    "release:check": "node ./scripts/check-desktop-release-metadata.mjs",
    "distribution:audit": "node scripts/package-manager-release.mjs audit",
    "distribution:prepare": "node scripts/package-manager-release.mjs prepare",
    "fix:linux-sandbox": "node ./scripts/linux-sandbox.mjs --fix",
    "check:linux-sandbox": "node ./scripts/linux-sandbox.mjs --warn"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "dependency-cruiser": "^18.4.0",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
