{
  "name": "pwrgit-workspace",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "Cross-platform desktop git client (Pwr family)",
  "author": "PwrDrvr LLC",
  "license": "MIT",
  "copyright": "Copyright \u00a9 2026 PwrDrvr LLC",
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4",
  "scripts": {
    "preinstall": "node ./scripts/check-node-version.mjs",
    "build": "node scripts/resource-run.mjs pnpm --filter @pwrgit/mcp-server build && node scripts/resource-run.mjs pnpm --filter @pwrgit/desktop build",
    "dev": "node scripts/resource-run.mjs pnpm --filter @pwrgit/desktop dev",
    "lint": "node scripts/resource-run.mjs pnpm lint:syntax && node scripts/resource-run.mjs pnpm lint:forge-kinds && node scripts/resource-run.mjs pnpm lint:colors && node scripts/resource-run.mjs pnpm deps:maturity && node scripts/resource-run.mjs pnpm licenses:check && node scripts/resource-run.mjs pnpm lint:boundaries && node scripts/resource-run.mjs pnpm typecheck",
    "lint:boundaries": "node scripts/resource-run.mjs depcruise --config .dependency-cruiser.cjs packages/ apps/desktop/src/",
    "lint:colors": "node scripts/resource-run.mjs node ./scripts/lint-renderer-colors.mjs",
    "lint:forge-kinds": "node scripts/resource-run.mjs node ./scripts/check-forge-kind-branching.mjs",
    "deps:maturity": "node scripts/resource-run.mjs node ./scripts/check-dependency-maturity.mjs",
    "licenses:allowlist": "node scripts/resource-run.mjs node ./scripts/check-third-party-license-allowlist.mjs",
    "licenses:check": "node scripts/resource-run.mjs node ./scripts/check-package-license-policy.mjs && node scripts/resource-run.mjs node ./scripts/check-third-party-license-allowlist.mjs && node scripts/resource-run.mjs node ./scripts/generate-third-party-licenses.mjs --check",
    "licenses:generate": "node scripts/resource-run.mjs node ./scripts/generate-third-party-licenses.mjs",
    "typecheck": "node scripts/resource-run.mjs pnpm -r --if-present typecheck",
    "test": "node scripts/resource-run.mjs vitest run",
    "test:watch": "node scripts/resource-run.mjs vitest",
    "test:e2e": "node scripts/resource-run.mjs pnpm --filter @pwrgit/desktop test:e2e",
    "test:desktop-e2e": "node scripts/resource-run.mjs pnpm --filter @pwrgit/desktop test:e2e",
    "release:check": "node ./scripts/check-desktop-release-metadata.mjs",
    "distribution:audit": "node scripts/package-manager-release.mjs audit",
    "distribution:prepare": "node scripts/package-manager-release.mjs prepare",
    "fix:linux-sandbox": "node ./scripts/linux-sandbox.mjs --fix",
    "check:linux-sandbox": "node ./scripts/linux-sandbox.mjs --warn",
    "lint:syntax": "node scripts/resource-run.mjs oxlint"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "cross-spawn": "^7.0.6",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "oxlint": "1.87.0",
    "proper-lockfile": "^4.1.2",
    "typescript": "^6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "^4.1.11"
  }
}
